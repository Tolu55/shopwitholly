# ========================================================
# ShopWithOlly Environment Variables Configuration
# ========================================================

# 1. SUPABASE / NEON DATABASE CONFIGURATION
# Obtain from your Supabase Project Settings -> API
# (https://app.supabase.com/project/_/settings/api)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# 2. MAILGUN CONFIRMATION EMAIL CONFIGURATION
# Obtain from your Mailgun Dashboard -> Sending -> API Keys & Domains
# (https://app.mailgun.com/)
MAILGUN_API_KEY=key-your-mailgun-api-key-here
MAILGUN_DOMAIN=mg.yourshopdomain.com
MAILGUN_FROM_EMAIL=ShopWithOlly Orders <orders@mg.yourshopdomain.com>

# 3. GOOGLE CLOUD CONSOLE AUTH CONFIGURATION
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
# Set Authorized Redirect URI in Google Cloud Console to:
# https://<your-supabase-project-id>.supabase.co/auth/v1/callback
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Application URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
